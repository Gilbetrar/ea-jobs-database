{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gilbetrar/ea-jobs-database/schemas/job.schema.json",
  "title": "EA Job Posting",
  "description": "Schema for an effective altruism job posting record",
  "type": "object",
  "required": ["id", "title", "organization", "source", "date_added"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique slug identifier: org-name--role-title--YYYY-MM",
      "pattern": "^[a-z0-9-]+--[a-z0-9-]+--\\d{4}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "description": "Job title as posted"
    },
    "organization": {
      "type": "string",
      "description": "Reference to organization ID (slug)"
    },
    "source": {
      "type": "string",
      "enum": ["slack-export", "80k-hours", "manual"],
      "description": "How this job was added to the database"
    },
    "source_url": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Original URL where the job was posted"
    },
    "jd_file": {
      "type": ["string", "null"],
      "description": "Relative path to markdown job description file in data/jds/"
    },
    "location": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["remote", "hybrid", "onsite"]
        },
        "cities": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["type"]
    },
    "salary": {
      "type": ["object", "null"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "currency": { "type": "string" },
        "period": {
          "type": "string",
          "enum": ["annual", "monthly"]
        }
      },
      "required": ["currency", "period"]
    },
    "posted_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date the job was originally posted (YYYY-MM-DD)"
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Application deadline (YYYY-MM-DD)"
    },
    "date_added": {
      "type": "string",
      "format": "date",
      "description": "Date this record was added to the database (YYYY-MM-DD)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Cause areas, role types, and other categorization tags"
    },
    "status": {
      "type": "string",
      "enum": ["open", "closed", "unknown"],
      "default": "unknown"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for parser-generated records (0-1)"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Freetext notes about this posting"
    }
  },
  "additionalProperties": false
}
